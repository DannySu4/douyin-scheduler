# 复制为 .env 后填写，切勿提交真实 .env 到 git
# 本地调试用；GitHub Actions 通过 Secrets 注入，不需要此文件

DOUYIN_COOKIE="你的抖音完整Cookie字符串"
TARGET_USER="https://www.douyin.com/im/?conversation_id=xxx   # 或用户主页URL"
MESSAGE_TEXT="你好，这是自动发送的测试消息"

# 可选
MODE="web"                 # web=无头浏览器(默认), http=纯协议模拟
HEADLESS="true"
NAV_TIMEOUT_MS="30000"
RANDOM_DELAY_MAX="0"
